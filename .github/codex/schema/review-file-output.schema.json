{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string"
    },
    "comments": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "start_line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "body": {
            "type": "string"
          },
          "suggestion": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "line",
          "start_line",
          "body",
          "suggestion"
        ]
      }
    }
  },
  "required": [
    "summary",
    "comments"
  ]
}
